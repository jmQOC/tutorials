<?xml version="1.0"?>
<odoo>

    <record id="jmqoc_estate_property_offer_view_list" model="ir.ui.view">
        <field name="name">jmqoc.estate.property.offer.list</field>
        <field name="model">jmqoc.estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Property Offer" limit="3">
                <!--
                <field name="property_id" width="29rem" />
                -->
                <field name="price" width="13rem" />
                <field name="partner_id" width="29rem" />
                <field name="validity" width="5rem" />
                <field name="deadline" width="11rem" />
                <button name="update_status" string="Accept" type="object" icon="fa-check" context="{'to_status': 'accepted'}" width="2rem" />
                <button name="update_status" string="Refuse" type="object" icon="fa-close" context="{'to_status': 'refused'}" width="2rem" />
                <field name="status" width="17rem" />
            </list>
        </field>
    </record>

    <record id="jmqoc_estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">jmqoc.estate.property.offer.form</field>
        <field name="model">jmqoc.estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Property Offer">
               <sheet>
                    <group>
                        <field name="property_id" />
                        <field name="partner_id" />                        
                    </group>
                    <group>
                        <field name="price" />
                        <field name="validity" />
                        <field name="deadline" />
                        <field name="status" />
                    </group>
               </sheet> 
            </form>
        </field>
    </record>

</odoo>