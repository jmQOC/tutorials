<?xml version="1.0"?>
<odoo>

    <record id="jmqoc_estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">jmqoc.estate.property</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="jmqoc_estate_property_view_search" model="ir.ui.view">
        <field name="name">jmqoc.estate.property.search</field>
        <field name="model">jmqoc.estate.property</field>
        <field name="arch" type="xml">
            <search string="Properties">
                <field name="name" />
                <field name="postal_code" />
                <field name="expected_price" />
                <field name="bedrooms" />
                <field name="living_area" />
                <field name="facades" />
                <separator/>
                <filter name="available" string="Available" domain="[('date_available', '&lt;=', context_today()), '|', ('state', '=', 'new'), ('state', '=', 'offer-received')]"/>
                <group expand="1" string="string">
                   <filter name="postal_code" string="Postcode" context="{'group_by':'postal_code', 'residual_visible':True}"/> 
                </group>
            </search>           
        </field>
    </record>

    <record id="jmqoc_estate_property_view_list" model="ir.ui.view">
        <field name="name">jmqoc.estate.property.list</field>
        <field name="model">jmqoc.estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties" limit="2">
                <!-- the display names are defined in the Python object -->
                <field name="name" width="29rem" />
                <field name="postal_code" width="7rem" />
                <field name="bedrooms" string="Bedrooms" width="3rem" />
                <field name="living_area" width="11rem" />
                <field name="expected_price" width="13rem" />
                <field name="selling_price" width="13rem" />
                <field name="date_available" width="11rem" />
            </list>
        </field>
    </record>

    <record id="jmqoc_estate_property_view_form" model="ir.ui.view">
        <field name="name">jmqoc.estate.property.form</field>
        <field name="model">jmqoc.estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <sheet>
                    <group>
                        <div class="oe_title mb32">
                            <div class="mb16">
                                <h1>
                                    <field name="name" />
                                </h1>
                                <group>
                                    <field name="property_type_id" />
                                </group>
                            </div>
                            <field name="property_tag_ids" widget="many2many_tags" />
                        </div>
                        <group>
                            <field name="state" />                        
                        </group>
                    </group>
                   <group>
                        <!-- groups are like flex boxes -->
                        <group>
                            <field name="street_address" />
                            <field name="city" />
                            <field name="state_id" />
                            <field name="postal_code" />
                            <field name="country_id" />                       
                        </group>
                        <group>
                            <field name="expected_price" />
                            <field name="selling_price" />
                            <field name="date_available" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description" />
                            </group>
                            <group>
                                <group>
                                    <field name="bedrooms" />
                                    <field name="living_area" />
                                    <field name="facades" />
                                    <field name="garage" />
                                </group>
                                <group>
                                    <field name="garden" />
                                    <field name="garden_area" />
                                    <field name="garden_orientation" />
                                </group>
                            </group>
                        </page>
                        <page string="Offers">
                            <field name="offer_ids" context="{'tree_view_ref': 'jmqoc_estate.jmqoc_estate_property_offer_view_list'}" />
                        </page>    
                        <page string="Other Info">
                            <group>
                                <field name="user_id" />
                                <field name="partner_id" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>